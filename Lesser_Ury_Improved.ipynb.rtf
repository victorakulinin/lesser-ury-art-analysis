    "def get_dominant_colors(image, n_colors=5):\\n",\
    "    img_array = np.array(image)\\n",\
    "    img_array = img_array.reshape((-1, 3))\\n",\
    "    kmeans = KMeans(n_clusters=n_colors, random_state=42)\\n",\
    "    kmeans.fit(img_array)\\n",\
    "    colors = kmeans.cluster_centers_.astype(int)\\n",\
    "    return colors"\
