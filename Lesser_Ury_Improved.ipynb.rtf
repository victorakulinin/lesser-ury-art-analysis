    "def load_image(url):\\n",\
    "    try:\\n",\
    "        response = requests.get(url)\\n",\
    "        img = Image.open(BytesIO(response.content)).convert('RGB')\\n",\
    "        return img\\n",\
    "    except Exception as e:\\n",\
    "        print(f\\"\uc0\u1054 \u1096 \u1080 \u1073 \u1082 \u1072  \u1079 \u1072 \u1075 \u1088 \u1091 \u1079 \u1082 \u1080  \{url\}: \{e\}\\")\\n",\
    "        return None\\n",\
